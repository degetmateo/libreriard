# ==============================================================================
# LIBRERÍA RUBÉN DARÍO - ENVIRONMENT VARIABLES CONFIGURATION
# Copy this file to .env in local development: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# ENVIRONMENT & GENERAL SERVER CONFIGURATION
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=5000

# ------------------------------------------------------------------------------
# DOMAIN URLS
# Development defaults:
# - Backend API:      http://localhost:5000
# - Staff Panel:      http://localhost:5001
# - Customer Store:   http://localhost:5002
#
# Production URLs:
# - Backend API:      https://api.libreriard.com.ar
# - Staff Panel:      https://staff.libreriard.com.ar
# - Customer Store:   https://libreriard.com.ar
# ------------------------------------------------------------------------------
API_URL=http://localhost:5000
STAFF_URL=http://localhost:5001
CLIENT_URL=http://localhost:5002

# Frontend Vite variables (used by apps/staff and apps/customer)
VITE_API_URL=http://localhost:5000/v1

# ------------------------------------------------------------------------------
# MONGODB DATABASE
# Connection URI for MongoDB database
# Example local: mongodb://127.0.0.1:27017/libreriard
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/libreriard?retryWrites=true&w=majority
# ------------------------------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017/libreriard
MONGODB_DB_NAME=libreriard

# ------------------------------------------------------------------------------
# JWT AUTHENTICATION & SECRETS
# JWT access token is short-lived (15 minutes).
# JWT refresh token is long-lived (7 days).
# Generate high-entropy random keys: openssl rand -base64 48
# ------------------------------------------------------------------------------
JWT_ACCESS_SECRET=libreriard_super_secret_access_jwt_key_development_change_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=libreriard_super_secret_refresh_jwt_key_development_change_in_production
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=libreriard_cookie_secret_sign_key_change_in_production

# ------------------------------------------------------------------------------
# EMAIL SERVICE (RESEND)
# Service used for customer activation, password recovery, wholesale alerts,
# and order confirmation receipts.
# Obtain API key from: https://resend.com
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_dev_placeholder_api_key
EMAIL_FROM=Librería Rubén Darío <no-reply@libreriard.com.ar>
ADMIN_NOTIFICATION_EMAIL=admin@libreriard.com.ar

# ------------------------------------------------------------------------------
# CLOUDINARY MEDIA STORAGE
# Image hosting for product catalogs and variants.
# Obtain credentials from: https://cloudinary.com/console
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=placeholder_cloud_name
CLOUDINARY_API_KEY=placeholder_api_key
CLOUDINARY_API_SECRET=placeholder_api_secret
CLOUDINARY_URL=cloudinary://placeholder_api_key:placeholder_api_secret@placeholder_cloud_name

# ------------------------------------------------------------------------------
# INITIAL SUPER ADMIN SEEDING (Used on first database bootstrap)
# ------------------------------------------------------------------------------
INITIAL_ADMIN_NAME="Administrador Rubén Darío"
INITIAL_ADMIN_EMAIL=admin@libreriard.com.ar
INITIAL_ADMIN_PASSWORD=RubenDarioAdmin2026!

